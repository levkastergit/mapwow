<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\FrameXML\UI.xsd">
	<!--
		Virtual template: the frame is created from Lua at PLAYER_LOGIN,
		after the Blizzard map canvas code is guaranteed to be loaded.
		Built the same way as Blizzard_BattlefieldMap (MapCanvasFrameTemplate + ScrollContainer child).
	-->
	<Frame name="DungeonPositionFrameTemplate" inherits="MapCanvasFrameTemplate" movable="true" resizable="true" clampedToScreen="true" frameStrata="MEDIUM" virtual="true">
		<Size x="320" y="230"/>
		<Frames>
			<ScrollFrame parentKey="ScrollContainer" inherits="MapCanvasFrameScrollContainerTemplate">
				<Anchors>
					<Anchor point="TOPLEFT" x="4" y="-22"/>
					<Anchor point="BOTTOMRIGHT" x="-4" y="4"/>
				</Anchors>
			</ScrollFrame>
			<Frame parentKey="TitleBar" enableMouse="true">
				<Size y="20"/>
				<Anchors>
					<Anchor point="TOPLEFT" x="4" y="-2"/>
					<Anchor point="TOPRIGHT" x="-4" y="-2"/>
				</Anchors>
				<Layers>
					<Layer level="BACKGROUND">
						<Texture parentKey="Bg" setAllPoints="true">
							<Color r="0" g="0" b="0" a="0.75"/>
						</Texture>
					</Layer>
					<Layer level="OVERLAY">
						<FontString parentKey="Text" inherits="GameFontNormalSmall" justifyH="LEFT" wordwrap="false">
							<Anchors>
								<Anchor point="LEFT" x="6" y="0"/>
								<Anchor point="RIGHT" x="-24" y="0"/>
							</Anchors>
						</FontString>
					</Layer>
				</Layers>
				<Frames>
					<Button parentKey="CloseButton" inherits="UIPanelCloseButtonNoScripts">
						<Size x="22" y="22"/>
						<Anchors>
							<Anchor point="RIGHT" x="2" y="0"/>
						</Anchors>
					</Button>
				</Frames>
			</Frame>
			<Button parentKey="ResizeGrip">
				<Size x="16" y="16"/>
				<Anchors>
					<Anchor point="BOTTOMRIGHT" x="-2" y="2"/>
				</Anchors>
				<NormalTexture file="Interface\ChatFrame\UI-ChatIM-SizeGrabber-Up"/>
				<HighlightTexture file="Interface\ChatFrame\UI-ChatIM-SizeGrabber-Highlight"/>
				<PushedTexture file="Interface\ChatFrame\UI-ChatIM-SizeGrabber-Down"/>
			</Button>
		</Frames>
	</Frame>
</Ui>
